<?xml version="1.0" encoding="utf-8"?>
<!-- Rivulet/App Store action button: glass when idle, solid white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#47FFFFFF" android:endColor="#2EFFFFFF" />
            <stroke android:width="0.5dp" android:color="#40FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
