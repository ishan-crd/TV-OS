<?xml version="1.0" encoding="utf-8"?>
<!-- Running apps (quick panel): memory in use, the apps opened since the TV started, Clear all. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:padding="14dp"
        android:orientation="vertical"
        android:background="@drawable/qp_panel_bg"
        android:elevation="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/ra_title"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/ui"
            android:fontVariationSettings="'wght' 600, 'opsz' 28" />

        <TextView
            android:id="@+id/raMemText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="@font/ui"
            android:fontVariationSettings="'wght' 500, 'opsz' 17" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/hero_progress_track">

            <View
                android:id="@+id/raMemFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/qp_mem_fill" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/raList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/raEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/ra_empty"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/ui"
            android:fontVariationSettings="'wght' 500, 'opsz' 17"
            android:visibility="gone" />

        <TextView
            android:id="@+id/raClearAll"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:background="@drawable/qp_tile_bg"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/ra_clear_all"
            android:textColor="@color/qp_fg"
            android:textSize="13.5sp"
            android:fontFamily="@font/ui"
            android:fontVariationSettings="'wght' 600, 'opsz' 17" />
    </LinearLayout>
</FrameLayout>
