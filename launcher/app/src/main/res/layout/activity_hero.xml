<?xml version="1.0" encoding="utf-8"?>
<!--
  Rivulet-style home (config.xml hero_home): a full-screen backdrop of the current dock app, its name,
  a line about it and an action row, page dots, and app rows peeking in at the bottom that slide up on
  Down. Sizes are Rivulet's tvOS points halved (a 1080p TV is 960x540 dp).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/backA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/backB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <!-- Darkens the backdrop while the rows are up. -->
    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0"
        android:visibility="gone" />

    <!-- Everything that slides up when focus moves to the rows. Taller than the screen on purpose. -->
    <FrameLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="1600dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/heroText"
            android:layout_width="460dp"
            android:layout_height="185dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="166dp"
            android:gravity="bottom"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:maxHeight="90dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.9"
                android:textColor="#FFFFFFFF"
                android:textSize="44sp"
                android:fontFamily="@font/ui"
                android:fontVariationSettings="'wght' 800, 'opsz' 28"
                android:letterSpacing="-0.015"
                android:shadowColor="#80000000"
                android:shadowDy="2"
                android:shadowRadius="8" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="#F2FFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/ui"
                    android:fontVariationSettings="'wght' 500, 'opsz' 17" />

                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:paddingTop="0.5dp"
                    android:paddingBottom="0.5dp"
                    android:background="@drawable/hero_badge"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textColor="#F2FFFFFF"
                    android:textSize="7.5sp"
                    android:fontFamily="@font/ui"
                    android:fontVariationSettings="'wght' 700, 'opsz' 17"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <TextView
                android:id="@+id/tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/ui"
                android:fontVariationSettings="'wght' 400, 'opsz' 17" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttons"
            android:layout_width="wrap_content"
            android:layout_height="33dp"
            android:layout_marginStart="37.5dp"
            android:layout_marginTop="359.5dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnOpen"
                android:layout_width="wrap_content"
                android:layout_height="33dp"
                android:minWidth="125dp"
                android:paddingStart="19.5dp"
                android:paddingEnd="19.5dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/hero_pill_bg"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnInputs">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/hero_btn_fg"
                    android:duplicateParentState="true"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/btnOpenLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:duplicateParentState="true"
                    android:includeFontPadding="false"
                    android:text="@string/hero_open"
                    android:textColor="@color/hero_btn_fg"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/ui"
                    android:fontVariationSettings="'wght' 600, 'opsz' 17" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnInfo"
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/hero_circle_bg"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnInputs">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_info_outline"
                    android:tint="@color/hero_btn_fg"
                    android:duplicateParentState="true"
                    android:contentDescription="@string/hero_info" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnNext"
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/hero_circle_bg"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnInputs">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/hero_btn_fg"
                    android:duplicateParentState="true"
                    android:contentDescription="@string/hero_next" />
            </FrameLayout>
        </LinearLayout>

        <com.gathin.tvhome.DotsView
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="423dp" />

        <!-- Featured film or series (TMDB details for titles your apps report): poster, genre chips, title,
             facts, plot, Watch / Wishlist, rating and a director-and-cast card. Shown instead of heroText,
             buttons when there is at least one. -->
        <FrameLayout
            android:id="@+id/movieHero"
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:clipChildren="false"
            android:visibility="gone">

            <ImageView
                android:id="@+id/mvPoster"
                android:layout_width="182dp"
                android:layout_height="270dp"
                android:layout_marginStart="52dp"
                android:layout_marginTop="97dp"
                android:background="@drawable/hero_card_bg"
                android:scaleType="centerCrop"
                android:elevation="6dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:id="@+id/mvInfo"
                android:layout_width="340dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="262dp"
                android:layout_marginTop="97dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/mvChips"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/mvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="0.95"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp"
                    android:fontFamily="@font/ui"
                    android:fontVariationSettings="'wght' 500, 'opsz' 28"
                    android:letterSpacing="-0.01"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="6" />

                <TextView
                    android:id="@+id/mvFacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:textColor="#D9FFFFFF"
                    android:textSize="11.5sp"
                    android:fontFamily="@font/ui"
                    android:fontVariationSettings="'wght' 500, 'opsz' 17" />

                <TextView
                    android:id="@+id/mvPlot"
                    android:layout_width="270dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.28"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/ui"
                    android:fontVariationSettings="'wght' 400, 'opsz' 17" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mvButtons"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="262dp"
                android:layout_marginTop="331dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/mvWatch"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="140dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="22dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/hero_pill_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@+id/btnWifi">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_play"
                        android:tint="@color/hero_btn_fg"
                        android:duplicateParentState="true"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/mvWatchLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:duplicateParentState="true"
                        android:includeFontPadding="false"
                        android:text="@string/mv_watch_movie"
                        android:textColor="@color/hero_btn_fg"
                        android:textSize="14.5sp"
                        android:fontFamily="@font/ui"
                        android:fontVariationSettings="'wght' 500, 'opsz' 17" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mvWish"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="140dp"
                    android:layout_marginStart="9dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="22dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/hero_pill_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusUp="@+id/btnWifi">

                    <ImageView
                        android:id="@+id/mvWishIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_mv_list_add"
                        android:tint="@color/hero_btn_fg"
                        android:duplicateParentState="true"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/mvWishLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:duplicateParentState="true"
                        android:includeFontPadding="false"
                        android:text="@string/mv_add_wishlist"
                        android:textColor="@color/hero_btn_fg"
                        android:textSize="14.5sp"
                        android:fontFamily="@font/ui"
                        android:fontVariationSettings="'wght' 500, 'opsz' 17" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right: rating, then director and cast. -->
            <LinearLayout
                android:id="@+id/mvSide"
                android:layout_width="152dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="52dp"
                android:layout_marginTop="92dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="40sp"
                    android:fontFamily="@font/ui"
                    android:fontVariationSettings="'wght' 700, 'opsz' 28"
                    android:letterSpacing="-0.02"
                    android:shadowColor="#66000000"
                    android:shadowRadius="6" />

                <TextView
                    android:id="@+id/mvVotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/ui"
                    android:fontVariationSettings="'wght' 500, 'opsz' 17" />

                <LinearLayout
                    android:id="@+id/mvCrew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp"
                    android:orientation="vertical"
                    android:background="@drawable/mv_glass_card" />

                <TextView
                    android:id="@+id/mvFullCast"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:background="@drawable/mv_glass_button"
                    android:focusable="true"
                    android:clickable="true"
                    android:text="@string/mv_full_cast"
                    android:textColor="@color/hero_btn_fg"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/ui"
                    android:fontVariationSettings="'wght' 500, 'opsz' 17"
                    android:nextFocusUp="@+id/btnWifi" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="456dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- 0 Similar movies (posters), 1 Your Apps, 2 Continue Watching, 3 Wishlist (posters), 4 All Apps.
                 Empty rows are hidden. -->
            <TextView
                android:id="@+id/row0Title"
                style="@style/HeroRowTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/row0"
                style="@style/HeroRow"
                android:layout_height="210dp" />

            <TextView
                android:id="@+id/row1Title"
                style="@style/HeroRowTitle"
                android:layout_marginTop="2dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/row1"
                style="@style/HeroRow" />

            <TextView
                android:id="@+id/row2Title"
                style="@style/HeroRowTitle"
                android:layout_marginTop="2dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/row2"
                style="@style/HeroRow" />

            <TextView
                android:id="@+id/row3Title"
                style="@style/HeroRowTitle"
                android:layout_marginTop="2dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/row3"
                style="@style/HeroRow"
                android:layout_height="210dp" />

            <TextView
                android:id="@+id/row4Title"
                style="@style/HeroRowTitle"
                android:layout_marginTop="2dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/row4"
                style="@style/HeroRow" />
        </LinearLayout>
    </FrameLayout>

    <!-- Top left: Rivulet's tab pill. -->
    <LinearLayout
        android:id="@+id/topLeft"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginStart="29dp"
        android:layout_marginTop="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:paddingStart="3dp"
            android:paddingEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/hero_glass_pill">

            <FrameLayout
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/hero_home_circle">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:includeFontPadding="false"
                android:text="@string/hero_home"
                android:textColor="#FFFFFFFF"
                android:textSize="14.5sp"
                android:fontFamily="@font/ui"
                android:fontVariationSettings="'wght' 600, 'opsz' 17" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top right: the clock and the network pill. (Inputs and Settings are on the remote's own buttons.) -->
    <LinearLayout
        android:id="@+id/topButtons"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="end"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="#E6FFFFFF"
            android:textSize="14.5sp"
            android:fontFamily="@font/ui"
            android:fontVariationSettings="'wght' 600, 'opsz' 17"
            android:shadowColor="#66000000"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/btnWifi"
            style="@style/HeroTopButton"
            android:maxWidth="160dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/wifi"
            android:nextFocusDown="@+id/btnOpen" />
    </LinearLayout>
</FrameLayout>
