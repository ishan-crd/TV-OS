<?xml version="1.0" encoding="utf-8"?>
<!-- One running app: the row opens it, ✕ closes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/raOpen"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/qp_tile_bg"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/raIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:duplicateParentState="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/raName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:duplicateParentState="true"
                android:textColor="@color/qp_fg"
                android:textSize="13sp"
                android:fontFamily="@font/ui"
                android:fontVariationSettings="'wght' 500, 'opsz' 17" />

            <TextView
                android:id="@+id/raWhen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:duplicateParentState="true"
                android:alpha="0.75"
                android:textColor="@color/qp_fg"
                android:textSize="10sp"
                android:fontFamily="@font/ui"
                android:fontVariationSettings="'wght' 400, 'opsz' 17" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/raClose"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:background="@drawable/qp_tile_bg"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="@string/ra_close">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_qp_close"
            android:tint="@color/qp_fg"
            android:duplicateParentState="true"
            android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>
